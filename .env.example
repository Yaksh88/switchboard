# Copy to .env and fill in. docker compose reads this file.

# Required: protects /admin and the dashboard. Generate one with: openssl rand -hex 32
SWITCHBOARD_ADMIN_TOKEN=

# Provider credentials referenced by config/switchboard.yaml (leave blank for providers you don't use).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: only needed if you run the observability profile.
GRAFANA_ADMIN_PASSWORD=
